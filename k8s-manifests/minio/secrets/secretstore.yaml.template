# SecretStore Template for MinIO
# This file is a template - DO NOT commit the actual secretstore.yaml with real tokens!
#
# To create the actual SecretStore:
# 1. Copy this file: cp secretstore.yaml.template secretstore.yaml
# 2. Replace YOUR_OPENBAO_ROOT_TOKEN with your actual OpenBao root token
# 3. Replace YOUR_OPENBAO_CLUSTER_IP with your OpenBao service ClusterIP
# 4. Apply: kubectl apply -f secretstore.yaml
#
# Note: secretstore.yaml is in .gitignore to prevent committing secrets

apiVersion: v1
kind: Secret
metadata:
  name: openbao-token
  namespace: minio
type: Opaque
stringData:
  token: YOUR_OPENBAO_ROOT_TOKEN
---
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: openbao-backend
  namespace: minio
spec:
  provider:
    vault:
      server: "http://YOUR_OPENBAO_CLUSTER_IP:8200"
      path: "secret"
      version: "v2"
      auth:
        tokenSecretRef:
          name: openbao-token
          key: token